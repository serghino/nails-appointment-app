{
  "name": "nails-appointment-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:nails-appointment-app": "node dist/nails-appointment-app/server/server.mjs",
    "api:dev": "tsx watch api/server.ts",
    "api:build": "tsc -p api/tsconfig.json",
    "api:start": "node dist/api/server.js",
    "dev": "concurrently \"npm run start\" \"npm run api:dev\"",
    "build:all": "npm run build && npm run api:build"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/animations": "^21.1.1",
    "@angular/cdk": "^21.1.1",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/material": "^21.1.1",
    "@angular/platform-browser": "^21.1.0",
    "@angular/platform-server": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@angular/ssr": "^21.1.1",
    "@supabase/supabase-js": "^2.95.3",
    "@types/nodemailer": "^7.0.11",
    "dotenv": "^17.2.4",
    "express": "^5.1.0",
    "nodemailer": "^8.0.2",
    "rxjs": "~7.8.0",
    "serverless-http": "^4.0.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.1",
    "@angular/cli": "^21.1.1",
    "@angular/compiler-cli": "^21.1.0",
    "@netlify/angular-runtime": "^3.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "concurrently": "^9.2.1",
    "jsdom": "^27.1.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
