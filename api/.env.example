# Backend API Environment Variables

# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:4200

# Database Configuration - Supabase (PostgreSQL)
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Admin Login (single admin user — Mary)
# To generate a new hash: node -e "require('bcryptjs').hash('YourPassword', 12).then(console.log)"
ADMIN_USERNAME=USERNAME
ADMIN_PASSWORD_HASH=$xa$xx$XXXXXXXXXXXXXXXX

# Email Configuration — Gmail SMTP
# 1. Enable 2-Step Verification on the Gmail account
# 2. Go to myaccount.google.com/apppasswords
# 3. Create an app password (name it e.g. "Nails App")
# 4. Paste the 16-character password below (no spaces)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password_here

# Admin Configuration
ADMIN_EMAIL=your_email@gmail.com
ADMIN_PHONE=+1234567890
